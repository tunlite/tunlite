{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tunlite.dev/schemas/connection-v1.schema.json",
  "title": "Tunlite Connection",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "metadata", "spec"],
  "properties": {
    "kind": { "const": "Connection" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$" },
        "tags": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,63}$" },
          "uniqueItems": true
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver", "config"],
      "properties": {
        "driver": { "type": "string", "minLength": 1 },
        "config": { "type": "object" }
      }
    }
  }
}
