{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tunlite.dev/schemas/ssh-config-v1.schema.json",
  "title": "Tunlite built-in SSH Driver configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["host", "forwards"],
  "properties": {
    "host": { "type": "string", "minLength": 1 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "identityFile": { "type": "string" },
    "jump": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "sshOptions": {
      "type": "array",
      "uniqueItems": true,
      "description": "OpenSSH Key=Value options accepted by Tunlite's conservative safe-option allowlist; Driver validation is authoritative.",
      "items": { "type": "string", "pattern": "^[^-\\r\\n\\u0000][^=\\r\\n\\u0000]*=.+$" }
    },
    "forwards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "srcPort"],
        "properties": {
          "type": { "enum": ["local", "remote", "dynamic"] },
          "bind": { "type": "string", "minLength": 1 },
          "srcPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "destHost": { "type": "string", "minLength": 1 },
          "destPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "enum": ["local", "remote"] } } },
            "then": { "required": ["destHost", "destPort"] }
          }
        ]
      }
    }
  }
}
