{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tunlite.dev/schemas/connection-list-v1.schema.json",
  "title": "Tunlite ConnectionList",
  "type": "object",
  "additionalProperties": false,
  "required": ["configVersion", "kind", "items"],
  "properties": {
    "configVersion": { "const": 1 },
    "kind": { "const": "ConnectionList" },
    "items": {
      "type": "array",
      "items": { "$ref": "connection-v1.schema.json" }
    }
  }
}
