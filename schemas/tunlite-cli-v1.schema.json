{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tunlite.dev/schemas/tunlite-cli-v1.schema.json",
  "title": "Tunlite CLI machine response",
  "type": "object",
  "required": ["contractVersion", "outcome"],
  "properties": {
    "contractVersion": { "const": "tunlite.cli/v1" },
    "outcome": { "enum": ["succeeded", "planned", "applied", "starting", "stopped", "partial", "failed"] },
    "dryRun": { "type": "boolean" },
    "conditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/condition" }
    },
    "error": { "$ref": "#/$defs/error" },
    "results": { "type": "array" }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "parameters"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object" }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message", "actions"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string" },
        "driver": { "type": "string" },
        "connection": { "type": "string" },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "driver", "connection", "message", "riskLevel", "requiresApproval", "actions"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "driver": { "type": ["string", "null"] },
        "connection": { "type": ["string", "null"] },
        "message": { "type": "string" },
        "riskLevel": { "enum": ["low", "medium", "high", "critical"] },
        "requiresApproval": { "type": "boolean" },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
      }
    }
  }
}
