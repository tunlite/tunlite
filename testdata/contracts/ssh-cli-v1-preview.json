{
  "contractVersion": "tunlite.blackbox/v1",
  "sourceVersion": "1.0.0-preview",
  "workflows": [
    {
      "name": "crud-and-forward-editing",
      "steps": [
        { "args": ["add", "web", "-p", "2222", "-L", "8080:localhost:80", "--group", "work", "me@host", "--json"], "exit": 0, "stdoutContains": ["\"outcome\":\"applied\"", "\"srcPort\":8080"] },
        { "args": ["list", "--group", "work", "--json"], "exit": 0, "stdoutContains": ["\"name\":\"web\""] },
        { "args": ["set", "web", "-D", "1080", "--json"], "exit": 0, "stdoutContains": ["\"type\":\"dynamic\"", "\"srcPort\":1080"] },
        { "args": ["rename", "web", "proxy", "--json"], "exit": 0, "stdoutContains": ["\"name\":\"proxy\""] },
        { "args": ["remove", "proxy", "--json"], "exit": 0, "stdoutContains": ["\"operation\":\"remove\""] },
        { "args": ["remove", "proxy", "--json"], "exit": 3, "stdoutContains": ["\"code\":\"not_found\""] }
      ]
    },
    {
      "name": "multi-forward-and-guardrails",
      "steps": [
        { "args": ["add", "multi", "-L", "15432:localhost:5432", "-R", "19000:localhost:3000", "-D", "11080", "me@host", "--json"], "exit": 0, "stdoutContains": ["\"type\":\"local\"", "\"type\":\"remote\"", "\"type\":\"dynamic\""] },
        { "args": ["add", "multi", "-D", "9999", "other@host", "--json"], "exit": 2, "stdoutContains": ["\"code\":\"already_exists\""] },
        { "args": ["add", "all", "-D", "1080", "me@host", "--json"], "exit": 0, "stdoutContains": ["\"outcome\":\"applied\"", "\"name\":\"all\""] },
        { "args": ["add", "missing-forward", "me@host", "--json"], "exit": 2, "stdoutContains": ["\"code\":\"invalid_arguments\""] },
        { "args": ["add", "bad-port", "-p", "70000", "-D", "1080", "me@host", "--json"], "exit": 2, "stdoutContains": ["\"code\":\"invalid_arguments\""] },
        { "args": ["add", "jump-injection", "-J", "user@-oProxyCommand=id 127.0.0.1", "-D", "1080", "me@host", "--json"], "exit": 2, "stdoutContains": ["\"code\":\"invalid_arguments\"", "invalid jump host"] }
      ]
    },
    {
      "name": "set-clear-and-conflicts",
      "steps": [
        { "args": ["add", "clearable", "-i", "~/.ssh/work", "-J", "jump@bastion", "-D", "1080", "-o", "Compression=yes", "me@host", "--json"], "exit": 0, "stdoutContains": ["\"identityFile\"", "\"jump\"", "\"sshOptions\""] },
        { "args": ["set", "clearable", "--clear", "identity", "--clear=jump", "--clear", "options", "--json"], "exit": 0, "stdoutContains": ["\"outcome\":\"applied\"", "\"name\":\"clearable\""], "stdoutNotContains": ["\"identityFile\"", "\"jump\"", "\"sshOptions\""] },
        { "args": ["set", "clearable", "--clear", "identity", "-i", "replacement", "--json"], "exit": 2, "stdoutContains": ["\"code\":\"invalid_arguments\"", "may only be specified once"] },
        { "args": ["list", "--json"], "exit": 0, "stdoutContains": ["\"name\":\"clearable\""], "stdoutNotContains": ["\"identityFile\"", "replacement"] }
      ]
    }
  ]
}
